# Config OGADE pour le serveur de dev EDF
#
# A copier vers /etc/ogade/ogade.env puis a adapter.
# C'est systemd qui lit ce fichier (EnvironmentFile), pas l'appli : l'API ne
# charge aucun .env toute seule.
#
# Droits conseilles : root:ogade en 0640, vu qu'il y a le mot de passe de la base.
#
# Format systemd : pas d'espace autour du =, pas de guillemets sauf s'ils font
# partie de la valeur, et pas de $VAR (ce n'est pas du shell, ca ne sera pas
# remplace).


# --- Base de donnees (obligatoire) ---

# L'instance PostgreSQL fournie par l'entreprise.
# Si le mot de passe contient des caracteres speciaux il faut les encoder :
# @ devient %40, : devient %3A, / devient %2F.
DATABASE_URL=postgresql://ogade:MOT_DE_PASSE@serveur-postgres.interne:5432/ogade?schema=public


# --- Reseau ---

# Port d'ecoute de l'appli, c'est la dessus que nginx redirige.
PORT=3000

# Origines autorisees pour le CORS. Comme l'interface est servie par la meme
# origine que l'API, ca sert surtout si un outil externe vient taper dessus.
# Mettre l'URL publique du service.
CORS_ORIGIN=https://ogade-dev.interne.edf.fr

# URL publique du service. Attention, elle est ecrite en dur dans les QR codes
# qu'on genere : si on se trompe, tous les QR deja imprimes pointent dans le
# vide, et corriger la variable ne change rien aux etiquettes deja collees.
API_URL=https://ogade-dev.interne.edf.fr


# --- Mode de fonctionnement ---

# On laisse NODE_ENV NON DEFINI sur ce serveur de dev : comme ca l'appli se
# comporte exactement comme aujourd'hui, rien ne bloque.
#
# Ce qu'il faut savoir : du coup l'en-tete x-user-email suffit pour etre
# authentifie comme n'importe quel compte, admin compris, sans mot de passe.
# Donc il faut vraiment limiter qui peut joindre le serveur.
#
# Pour durcir plus tard (recette ou prod), decommenter la ligne ci-dessous ET
# remplir JWT_SECRET juste apres :
#NODE_ENV=production

# Obligatoire seulement si NODE_ENV=production, 32 caracteres minimum.
# Pour en generer un : openssl rand -base64 48
# A savoir : changer cette valeur deconnecte tout le monde.
#JWT_SECRET=


# --- Connexion Microsoft (optionnel) ---

# Si on remplit ces deux variables, l'appli bascule sur Entra ID et le repli par
# en-tete est coupe, quel que soit NODE_ENV.
# Il faut un acces sortant vers login.microsoftonline.com, et penser a declarer
# l'URL publique comme URI de redirection cote Entra.
#AZURE_AD_TENANT_ID=
#AZURE_AD_CLIENT_ID=


# --- Reglages optionnels ---

# Taille max d'un fichier envoye, en Mo (25 par defaut).
# A garder coherent avec client_max_body_size cote nginx.
#MAX_UPLOAD_MB=25

# La doc Swagger. Active par defaut sauf en prod.
#ENABLE_SWAGGER=true

# Fuseau horaire du process. C'est lui qui decide de l'heure a laquelle part la
# tache des relances d'etalonnage (8h du matin).
TZ=Europe/Paris
