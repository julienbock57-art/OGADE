# Variables d'environnement OGADE
#
# ATTENTION : l'API ne charge aucun fichier .env au démarrage (ni @nestjs/config,
# ni dotenv). Ces variables doivent être présentes dans l'environnement du
# processus — via « EnvironmentFile= » d'une unité systemd, un export shell, ou
# la configuration de l'hébergeur.
#
# Seule la CLI Prisma lit un fichier .env. D'où une confusion fréquente : les
# migrations trouvent la base alors que l'application, elle, ne la voit pas.

# ─── Base de données (obligatoire) ───────────────────────────────────
# PostgreSQL exclusivement : le schéma s'appuie sur des types propres à
# PostgreSQL (BYTEA, JSONB, SERIAL) et sur la recherche insensible à la casse
# de Prisma, non prise en charge par les autres moteurs.
DATABASE_URL="postgresql://ogade:ogade@localhost:5432/ogade?schema=public"

# ─── API ───────────────────────────────────────────────────────
PORT=3000

# Origine autorisée pour CORS ; « * » les autorise toutes.
CORS_ORIGIN="http://localhost:5173"

# URL publique de l'application. Elle est encodée dans les QR codes générés :
# une valeur erronée rend inutilisables tous les QR déjà imprimés.
API_URL="http://localhost:3000"

# ─── Sécurité ─────────────────────────────────────────────────
# NODE_ENV=production active les garde-fous :
#   - JWT_SECRET devient obligatoire et sa robustesse est vérifiée ;
#   - le repli d'authentification par en-tête x-user-email est désactivé ;
#   - la documentation Swagger n'est plus exposée.
# En son absence, l'application fonctionne en mode développement : l'en-tête
# x-user-email suffit alors à obtenir un accès complet, sans mot de passe.
# NODE_ENV=production

# Obligatoire dès lors que NODE_ENV=production (32 caractères minimum).
# Générer avec : openssl rand -base64 48
# JWT_SECRET=""

# ─── Authentification Microsoft (optionnelle) ─────────────────────────
# Sans ces variables, seule l'authentification locale (e-mail + mot de passe)
# est proposée. Leur présence désactive le repli par en-tête, quel que soit
# NODE_ENV. Nécessite un accès sortant vers login.microsoftonline.com.
# AZURE_AD_TENANT_ID=""
# AZURE_AD_CLIENT_ID=""

# ─── Réglages optionnels ────────────────────────────────────────
# Taille maximale d'un fichier téléversé, en Mo (défaut : 25). Le proxy inverse
# doit être configuré en cohérence (client_max_body_size côté nginx).
# MAX_UPLOAD_MB=25

# Force l'exposition (« true ») ou le masquage (« false ») de la documentation
# Swagger, indépendamment de NODE_ENV.
# ENABLE_SWAGGER=true

# Fuseau horaire du processus, utilisé par la tâche planifiée des relances
# d'étalonnage.
# TZ=Europe/Paris

# Note : aucune variable VITE_* n'est nécessaire. L'interface récupère sa
# configuration d'authentification à l'exécution via /api/v1/auth/config, et
# appelle l'API sur la même origine. Le bundle est donc indépendant de
# l'environnement et n'a pas à être reconstruit pour changer de serveur.
